{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "packages/protocol/src/**/*.ts",
    "packages/i18n/src/**/*.ts",
    "dev/**/*.tsx"
  ]
}
