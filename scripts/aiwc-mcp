#!/bin/bash
set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")" && pwd)"
EXE_PATH="${AIWC_DESKTOP_EXE:-}"
if [[ -z "${EXE_PATH}" ]]; then
  PLIST_PATH="${APP_DIR}/../Info.plist"
  if [[ -f "${PLIST_PATH}" ]]; then
    BUNDLE_EXECUTABLE="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "${PLIST_PATH}" 2>/dev/null || true)"
    if [[ -n "${BUNDLE_EXECUTABLE}" ]]; then
      EXE_PATH="${APP_DIR}/${BUNDLE_EXECUTABLE}"
    fi
  fi
fi
MCP_ARCHIVE="${APP_DIR}/../Resources/app.asar"
MCP_ENTRY_UNPACKED="${APP_DIR}/../Resources/app.asar.unpacked/dist-electron/mcp.js"
MCP_ENTRY="${MCP_ARCHIVE}/dist-electron/mcp.js"
MCP_BOOTSTRAP="${APP_DIR}/aiwc-mcp-bootstrap.cjs"

if [[ -z "${EXE_PATH}" || ! -f "${EXE_PATH}" ]]; then
  >&2 echo "[AIWC MCP Launcher] desktop executable not found; set AIWC_DESKTOP_EXE"
  exit 1
fi

if [[ ! -f "${MCP_BOOTSTRAP}" ]]; then
  >&2 echo "[AIWC MCP Launcher] MCP bootstrap not found at \"${MCP_BOOTSTRAP}\""
  exit 1
fi

if [[ -f "${MCP_ENTRY_UNPACKED}" ]]; then
  MCP_ENTRY="${MCP_ENTRY_UNPACKED}"
elif [[ ! -f "${MCP_ARCHIVE}" ]]; then
  >&2 echo "[AIWC MCP Launcher] app.asar not found at \"${MCP_ARCHIVE}\""
  exit 1
fi

export ELECTRON_RUN_AS_NODE=1
export AIWC_MCP_LAUNCHER=packaged-launcher
export AIWC_MCP_ENTRY="${MCP_ENTRY}"

exec "${EXE_PATH}" "${MCP_BOOTSTRAP}" "$@"
