{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "electron/**/*.ts",
    "packages/**/*.ts",
    "dev/**/*.ts"
  ],
  "exclude": ["packages/**/*.test.ts", "electron/**/*.test.ts"]
}
